GEMINI_API_KEY=your_gemini_api_key_here

# Slack Socket Mode bridge (packages/bridges/slack).
# Copy this file to .env, uncomment these lines, and replace every placeholder.
# Never commit .env; it is ignored by git.
# SLACK_BOT_TOKEN=xoxb-replace-me
# SLACK_APP_TOKEN=xapp-replace-me
# SLACK_ALLOWED_USERS=U0123456789
# SLACK_ALLOWED_CHANNELS=C0123456789
# SLACK_INVOCATION_MODE=mention
# SLACK_DM_ACCESS=user
# SLACK_SESSION_GRANULARITY=thread
# SLACK_ACK_REACTION=0
# Use the same random value (at least 32 characters) for the server and bridge.
# MULMOCLAUDE_AUTH_TOKEN=replace-with-at-least-32-random-characters

# Client locale for vue-i18n. Supported: "en" (default), "ja".
# Picked up at build/dev time via import.meta.env.VITE_LOCALE.
# VITE_LOCALE=en

# CSRF-guard allowlist for cross-origin state-changing requests
# (POST/PUT/PATCH/DELETE). Localhost is always allowed; use this
# to permit a LAN device (e.g. an iPad) to reach `yarn dev` from
# another machine. Comma-separated, verbatim match against the
# `Origin` header — include the scheme and port and do NOT add a
# trailing slash. The literal string `null` is rejected even if
# listed (it's what browsers send for sandboxed iframes / file:// /
# data: pages, which must never be honored as a trusted origin).
# Example:
# MULMOCLAUDE_TRUSTED_ORIGINS=http://192.168.1.42:5173
